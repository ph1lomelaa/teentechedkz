# Настройки Attendee. Скопируйте в attendee.env на сервере и заполните.
# В репозиторий attendee.env НЕ коммитить: там секреты.

# --- Django (сгенерировать: см. README, шаг 3) ---
DJANGO_SETTINGS_MODULE=attendee.settings.production
DJANGO_SECRET_KEY=
CREDENTIALS_ENCRYPTION_KEY=
SITE_DOMAIN=attendee.teenteched.kz
ALLOWED_HOSTS=attendee.teenteched.kz,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://attendee.teenteched.kz
# TLS снимает Caddy, внутри — http с X-Forwarded-Proto
DJANGO_SSL_REQUIRE=true
TIME_ZONE=Asia/Almaty
# Почты нет — подтверждение аккаунта делаем командой (README, шаг 7)
DISABLE_EMAIL=true

# --- Где Caddy видит API и файлы Attendee ---
# 127.0.0.1 — Caddy установлен на сервере как служба;
# 172.17.0.1 — Caddy работает в Docker-контейнере (адрес docker0 на хосте).
ATTENDEE_BIND=127.0.0.1

# --- База и Redis (только 127.0.0.1) ---
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=attendee
POSTGRES_USER=attendee
POSTGRES_PASSWORD=
POSTGRES_SSL_REQUIRE=false
REDIS_URL=redis://127.0.0.1:6380/0
# Redis без TLS: REDIS_SSL_REQUIREMENTS и DISABLE_REDIS_SSL не задавать.

# --- Хранилище записей (MinIO из этого же compose) ---
STORAGE_PROTOCOL=s3
AWS_ENDPOINT_URL=https://attendee-files.teenteched.kz
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_RECORDING_STORAGE_BUCKET_NAME=attendee-recordings

# --- Запуск ботов: каждый в отдельном контейнере ---
LAUNCH_BOT_METHOD=docker-compose-multi-host
BOT_CONTAINER_IMAGE=teenteched/attendee:500168b
BOT_HOST_CODE_PATH=/opt/attendee
# Сколько встреч одновременно. Прод 03.10.2026: 6 vCPU / 11 ГБ, платформа ~4 ГБ.
# Типичная встреча — 3 человека, до часа, пишем только звук (mp3): бот берёт
# заметно меньше 2 ГБ. Поэтому 5 ботов с потолком 1400m: в худшем случае 7 ГБ —
# столько и свободно. Бот, упёршийся в потолок, падает сам (текст до обрыва
# сохраняется), CRM при этом не страдает. Swap 4 ГБ на хосте — страховка.
# Поднимать дальше только по `docker stats` реальных встреч.
BOT_MAX_SIMULTANEOUS_BOTS=5
BOT_MEMORY_LIMIT=1400m
BOT_CPU_QUOTA=100000
# Встречи до часа: 2 часа хватает с запасом, зависший бот освобождает место раньше
BOT_MAX_EXECUTION_SECONDS=7200
