# ОБРАЗЕЦ, НЕ ПОДКЛЮЧЁН. Прод-Caddy общий и живёт ВНЕ этого репо (см.
# ARCHITECTURE.md) — сервиса caddy нет ни в docker-compose.yml, ни в
# docker-compose.prod.yml. Правки здесь ни на что не влияют; файл оставлен как
# референс маршрутизации (/health, /api/*, фронт). Меняешь прод — правь конфиг
# на сервере, а не этот файл.

{
    email {$CADDY_EMAIL}
}

teenteched.duckdns.org {
    encode zstd gzip

    handle /health {
        reverse_proxy backend:8000
    }

    handle /api/* {
        reverse_proxy backend:8000
    }

    handle {
        reverse_proxy frontend:80
    }
}

