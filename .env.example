# TeenTechEd root environment
# Fill only the secret values below. Non-secret defaults can stay as is.

# Database
POSTGRES_USER=tte
POSTGRES_PASSWORD=tte
POSTGRES_DB=tte_db
DATABASE_URL=postgresql+asyncpg://tte:tte@postgres:5432/tte_db

# Auth
JWT_SECRET_KEY=change-me-in-production-min-32-chars-long-random
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30

# Вход через Google. Пусто = способ выключен: кнопка на экране входа не
# рисуется, /auth/google отвечает 503. Это OAuth 2.0 Client ID типа
# «Web application» из Google Cloud Console; client secret не нужен — поток
# id_token его не использует. В настройках клиента укажите Authorized
# JavaScript origins: адрес фронта (http://localhost:3000 для разработки).
# Имя переменной именно такое — код читает GOOGLE_OAUTH_CLIENT_ID
# (app/core/config.py). GOOGLE_CLIENT_ID без OAUTH_ приложение не видит.
# Значение здесь всегда пустое: это шаблон, он лежит в гите. Настоящий
# client ID — в .env, который git игнорирует.
GOOGLE_OAUTH_CLIENT_ID=

# Код для самозаписи менторов: /join?code=<это значение>. Совпал — ментор
# заходит сразу, не совпал — попадает в очередь заявок к админу. Пусто =
# код выключен, все менторы идут через очередь. Студентов это не касается:
# им доступ открывает совпадение телефона с карточкой.
# Смена значения требует перезапуска backend.
JOIN_MENTOR_CODE=

# Encryption (pgcrypto) - for IIN and confidential notes
PGCRYPTO_KEY=change-me-in-production-min-32-chars-long-random

# MinIO / S3
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=teenteched-docs
MINIO_USE_SSL=false

# Redis
REDIS_URL=redis://redis:6379/0

# Web tier scaling (docker-compose.prod.yml) — verify actual CPU cores on the
# server with `nproc` before changing UVICORN_WORKERS; DB_POOL_SIZE/MAX_OVERFLOW
# are per-process, so total Postgres connections ≈ UVICORN_WORKERS × (DB_POOL_SIZE + DB_MAX_OVERFLOW)
# + the worker container's own (WORKER_DB_POOL_SIZE + WORKER_DB_MAX_OVERFLOW) — keep the sum under Postgres's max_connections.
UVICORN_WORKERS=2
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5
WORKER_DB_POOL_SIZE=5
WORKER_DB_MAX_OVERFLOW=2

# Telegram — single bot: mentor commands (private chats) + client group ingestion
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# Local dev only: claim a free static domain in the ngrok dashboard (Cloud
# Edge -> Domains) so TELEGRAM_WEBHOOK_URL never changes between restarts.
# Used by scripts/tunnel.sh (`make tunnel`). Leave empty to use a random
# ngrok URL (changes every restart).
NGROK_STATIC_DOMAIN=

# Notion
NOTION_API_KEY=
# ID внутреннего data source (Manage data sources → Copy data source ID),
# не ID контейнера базы из URL.
NOTION_DATABASE_ID=
ENABLE_NOTION_PIPELINE_APPLY=false
# Telegram-группе ученика: «встреча назначена/перенесена/отменена» и напоминание за час
ENABLE_MEETING_TELEGRAM_NOTIFICATIONS=false
# Автоответ ученикам в Telegram вне рабочего времени и в праздники РК
# (календарь — backend/app/core/kz_calendar_data.py, обновлять ежегодно)
ENABLE_TELEGRAM_OFF_HOURS_REPLY=true
TELEGRAM_OFF_HOURS_REPLY_COOLDOWN_SECONDS=21600
TELEGRAM_OFF_HOURS_STAFF_QUIET_SECONDS=10800
COMPANY_WORKDAY_START_HOUR=10
COMPANY_WORKDAY_END_HOUR=19
# Отметка сотрудников: 10:00 по поясу сотрудника, напоминание за 10 минут
CHECKIN_REMINDER_LEAD_MINUTES=10
CHECKIN_CHECK_INTERVAL_SECONDS=60

# Google Sheets migration / sync
GOOGLE_AUTHORIZED_USER_JSON=
# Автосинк анкет: JSON ключ сервисного аккаунта одной строкой ИЛИ путь к файлу
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SERVICE_ACCOUNT_FILE=/data/google_service_account.json
SHEETS_SYNC_INTERVAL_SECONDS=300
# Анкеты без похожего кандидата после каждого синка сами становятся карточками
# студентов в общей базе — без статуса, чтобы картина по заявкам была полной.
# Анкеты, похожие на существующего студента, автоматика не трогает: их
# привязывает человек (иначе пойдут дубли). false — вернуть прежнее поведение,
# когда карточки создавались только кнопкой «Создать из новых анкет».
ENABLE_INTAKE_AUTO_CREATE=true

# AI / transcription
# Ключ Deepgram с ролью Member (не ниже): из него выпускаются временные токены для браузера.
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Бот, который записывает встречи (Zoom / Google Meet / Teams). Развёртывание Attendee — attendee/README.md
# MEETING_BOT_PROVIDER: attendee — наш сервер Attendee; mock — имитация для разработки
# (при ENVIRONMENT=production mock запрещён: бэкенд не стартует).
MEETING_BOT_ENABLED=false
MEETING_BOT_PROVIDER=attendee
ATTENDEE_API_URL=
ATTENDEE_API_KEY=
# Base64-секрет из Attendee: Settings → Webhooks
ATTENDEE_WEBHOOK_SECRET=
# Публичный https-адрес для вебхуков; пусто — берётся FRONTEND_URL
PUBLIC_API_BASE_URL=
# Zoom Marketplace → App Credentials. Нужен только Client ID;
# Client Secret вводится в настройках Attendee, не сюда.
ZOOM_CLIENT_ID=
ZOOM_REDIRECT_URI=https://teenteched.kz/api/v1/integrations/zoom/callback
MEETING_BOT_NAME=TeenTechEd
MEETING_BOT_WATCHDOG_INTERVAL_SECONDS=60
# Чистка попыток записи: пустые удаляются через сутки, зависшие помечаются прерванными
ENABLE_NOTE_SESSION_CLEANUP=true
# Пока false — проверка качества конспекта только считает показатели (режим наблюдения)
NOTE_QUALITY_ENFORCE=false

# Observability (Sentry) — пусто => выключено. Один DSN на бэк, отдельный на фронт.
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.0
VITE_SENTRY_DSN=

# CORS / app
ENVIRONMENT=production
# Доверять X-Forwarded-For (rate-limit по реальному IP). True — за Caddy, когда
# backend НЕ опубликован в хост. False — если бэкенд доступен напрямую.
TRUST_PROXY_HEADERS=true
FRONTEND_URL=https://teenteched.kz
ALLOWED_ORIGINS=https://teenteched.kz,https://www.teenteched.kz
VITE_API_URL=https://teenteched.kz
CADDY_EMAIL=you@example.com

# First admin seed
FIRST_ADMIN_EMAIL=admin@teenteched.kz
FIRST_ADMIN_PASSWORD=Admin1234!
